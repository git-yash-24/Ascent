{
  "name": "ascent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ascent: a habit tracker through which you live a year-long story on a mountain route.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit && vite build",
    "artifact": "npm run build && node tools/artifactize.mjs",
    "check": "npm run typecheck && npm run test && npm run artifact"
  },
  "devDependencies": {
    "fast-check": "^3.23.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^2.1.8"
  }
}
